pkgname=nfgram-desktop-bin
pkgver=7.3.1.r38145208048
pkgrel=1
_run_id=38145208048
_commit=13f1f8c7971ef32d5cc136b2f16ec54fc316abfb
pkgdesc="A third-party Telegram client based on 64Gram and Telegram Desktop - binary version"
arch=('x86_64')
url="https://github.com/frknkrc44/NFGram"
license=('GPL-3.0-or-later')
depends=(
  'desktop-file-utils'
  'fontconfig'
  'glib2'
  'hicolor-icon-theme'
  'libdbus'
  'libglvnd'
  'libx11'
)
optdepends=('ttf-opensans: default Open Sans font family')
provides=('nfgram-desktop')
conflicts=('nfgram-desktop')

source=(
  "io.github.NFGram.desktop"
  "LICENSE-${_commit}::https://raw.githubusercontent.com/frknkrc44/NFGram/${_commit}/LICENSE"
  "${url}/raw/${_commit}/Telegram/Resources/art/icon"{16,32,48,64,128,256,512}".png"
  "${pkgname}-${pkgver}.zip::https://nightly.link/frknkrc44/NFGram/actions/runs/${_run_id}/Telegram-Desktop.zip"
)

sha256sums=(
  'a39f7a94df1a3879dfb9edd38ef4a99463748b445f816b0ebd6a4c215810d2a1'
  'a728b65d02eeaf6b50c075a33b76107c652c3e5a12ff67f53682c83d47a23e1e'
  'ea1f36152b143cc2664daef5026656d55be2230ed42d43628e17ef7d2fff718c'
  '9e4180c78c895783b4559c5e1a7868a2c9aa30a29969fe5dbe9a4ce4cf5cde6c'
  '041b78681a35f07c3c929662fc66b6592c88588dc7297a5394ef7f923f2118e2'
  '554dff9f55697d4e8ec69e9aa53678aa5dae3e91aa13adc3b115526d8d51dfc9'
  '731431e47a5bc91c697d25c3a54fe7ba004752f5b66e0f282c47588ff7a314e6'
  '3fb1400c7dc9bbc3b5cb3ffedcbf4a9b09c53e28b57a7ff33a8a6b9048864090'
  'e297771c75bd2f81d637a3234f83568be62092f67d16946be23895fa92fa7119'
  'b0bfdf7b7475a6bbffa15d2493749ea305e0bd8586d29f3a819548ea94f2679d'
)

package() {
  cd "${srcdir}"

  # Program binary
  install -Dm755 Telegram "${pkgdir}/usr/bin/nfgram-desktop"

  # Desktop launcher & pixmap
  install -Dm644 io.github.NFGram.desktop "${pkgdir}/usr/share/applications/io.github.NFGram.desktop"
  install -Dm644 icon256.png "${pkgdir}/usr/share/pixmaps/nfgram.png"

  # Application icons
  local icon_size icon_dir
  for icon_size in 16 32 48 64 128 256 512; do
    icon_dir="${pkgdir}/usr/share/icons/hicolor/${icon_size}x${icon_size}/apps"
    install -d "${icon_dir}"
    install -m644 "icon${icon_size}.png" "${icon_dir}/nfgram.png"
  done

  # License
  install -Dm644 "LICENSE-${_commit}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # Disable internal updater if updater config is checked
  install -dm755 "${pkgdir}/usr/share/NFGram/externalupdater.d"
  echo "/usr/bin/nfgram-desktop" > "${pkgdir}/usr/share/NFGram/externalupdater.d/telegram-desktop.conf"
}
